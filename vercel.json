{
  "version": 2,
  "builds": [
    {
      "src": "frontend/icengcit-react/package.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/icengcit-react/dist/$1"
    }
  ]
}
